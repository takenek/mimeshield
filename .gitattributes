# Release archives (git archive / GitHub / Packagist dist) contain only what a Roundcube installation
# needs: the test suite (incl. the public TEST-ONLY PKI) and developer tooling are excluded (INF-06).
/tests export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.php-cs-fixer.dist.php export-ignore
/phpstan.neon.dist export-ignore
/phpunit.xml.dist export-ignore
# security audit working documents and delivered artefacts (never part of a release)
/FINAL_SECURITY_REPORT.md export-ignore
/STAGE_*.md export-ignore
/DOSTARCZONE export-ignore
